DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Privacidad de datos del cliente frente a proveedores externos de IA.
# 0 = el analisis IA no envia balances/datos del cliente a APIs externas
#     (recomendado en desarrollo con datos reales y mientras no exista un
#      acuerdo de tratamiento de datos con el proveedor).
# 1 = envio habilitado.
# Alternativa local sin salida de datos: LM_STUDIO_BASE_URL=http://localhost:1234
AI_CLIENT_DATA_ENABLED=1
# LM_STUDIO_BASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=

ENV=development
ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=dev-secret-change-in-prod-min-32-chars!!
JWT_EXPIRE_MINUTES=60

# Production (Railway)
ALLOWED_ORIGINS=https://socio-ai-frontend.vercel.app,https://tu-dominio-custom.com
ENV=production
JWT_SECRET_KEY=your-production-secret-min-32-chars-strong!!
RATE_LIMIT_REDIS_URL=redis://user:password@host:port

ADMIN_USERNAME=socioai_admin
ADMIN_PASSWORD=CHANGE_ME
ALLOWED_CLIENTES=*
SOCIO_ORG_ID=org-socio-main
