# Local development
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Production (Vercel + Railway)
NEXT_PUBLIC_API_BASE=https://socio-inteligente-production.up.railway.app
NEXT_PUBLIC_WS_BASE=wss://socio-inteligente-production.up.railway.app
NEXT_PUBLIC_API_TIMEOUT_MS=20000
NEXT_PUBLIC_DASHBOARD_AREAS_PAGE_SIZE=8

# Navegacion: por defecto solo se muestran los modulos del MVP de analisis
# (Clientes, Perfil, Trial Balance, Mayor, Indices, Dashboard, Risk Engine,
# Socio Chat, Biblioteca, Procedimientos). Con 1 se muestra la plataforma completa.
# NEXT_PUBLIC_FULL_PLATFORM=1
